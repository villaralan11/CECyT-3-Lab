# Conexión pooled (runtime de la app: Vercel/serverless, vía PgBouncer puerto 6543)
DATABASE_URL="postgresql://postgres.REFDELPROYECTO:CONTRASENA_FICTICIA@aws-0-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Conexión directa (solo para migraciones de Prisma, puerto 5432)
DIRECT_URL="postgresql://postgres:CONTRASENA_FICTICIA@db.REFDELPROYECTO.supabase.co:5432/postgres"

# Server-only NVIDIA configuration for Notebook CECyT
# Esta clave SOLO vive en el servidor (Vercel): nunca en componentes cliente ni en variables NEXT_PUBLIC_*
NVIDIA_API_KEY=replace_with_a_new_nvidia_api_key
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# URL pública del sitio (opcional, para metadatos/canónicas)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
